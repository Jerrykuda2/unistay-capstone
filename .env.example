# Backend (create a file named .env in the backend or repo root)
# Example values — DO NOT commit real secrets to source control.
# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=secretpassword
DB_NAME=unistay_db
# Server
PORT=5000
# JWT secret used to sign access tokens
JWT_SECRET=your_jwt_secret_here
# Google OAuth client ID (set up in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend (Vite) — create a .env in unistay-frontend or set locally
# Vite requires the `VITE_` prefix for environment variables exposed to client code.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_OAUTH_DISABLED=false

# Backend dev bypass (set to true to allow dev sign-in without real Google ID)
GOOGLE_OAUTH_DISABLED=false

# Notes:
# - Place a real `.env` at the project root (or in backend/.env) with the values above.
# - Keep secrets out of version control. Use a secure secret manager in production.
